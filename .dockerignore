# Build context exclusions — keeps the image small and secrets out of layers.
# NOTE: package.json, package-lock.json, tsconfig.json, src/, public/ and
# audit/ must stay in the context; the Dockerfile copies them explicitly.

# Dependencies — reinstalled inside the image with `npm ci`
node_modules
**/node_modules

# Build / tooling output — regenerated by the builder stage
dist
coverage
.nyc_output
*.tsbuildinfo
.cache

# Secrets and local environment files — never copy these into an image
.env
.env.*

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Version control and CI metadata
.git
.gitignore
.gitattributes
.github

# Tests — executed in CI, not needed in the runtime image
tests
**/*.test.ts
**/*.spec.ts

# Docker and editor/OS cruft
Dockerfile
.dockerignore
docker-compose*.yml
.vscode
.idea
.DS_Store
Thumbs.db
