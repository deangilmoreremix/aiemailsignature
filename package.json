{
  "name": "openai-real-api-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Application using the OpenAI Responses API and gpt-image-2 image generation. No mock data.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --loader ts-node/esm src/index.ts",
    "ui": "tsx src/server.ts",
    "test": "vitest run",
    "audit": "node audit/check.mjs"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "openai": "^4.104.0",
    "tsx": "^4.23.11"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4"
  }
}
